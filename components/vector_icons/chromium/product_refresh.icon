CANVAS_DIMENSIONS, 24,
FILL_RULE_NONZERO,
// PolyBrowser coral-red (#FF5951) hexagon-cube logo
PATH_COLOR_ARGB, 0xFF, 0xFF, 0x59, 0x51,
// Top chevron
MOVE_TO, 12, 1.2f,
LINE_TO, 21.2f, 6.5f,
LINE_TO, 18.2f, 8.4f,
LINE_TO, 12, 4.8f,
LINE_TO, 5.8f, 8.4f,
LINE_TO, 2.8f, 6.5f,
CLOSE,
// Left bracket
MOVE_TO, 1.4f, 9.0f,
LINE_TO, 4.5f, 10.8f,
LINE_TO, 4.5f, 17.2f,
LINE_TO, 10.2f, 20.5f,
LINE_TO, 10.2f, 23.2f,
LINE_TO, 1.4f, 18.2f,
CLOSE,
// Right bracket
MOVE_TO, 22.6f, 9.0f,
LINE_TO, 19.5f, 10.8f,
LINE_TO, 19.5f, 17.2f,
LINE_TO, 13.8f, 20.5f,
LINE_TO, 13.8f, 23.2f,
LINE_TO, 22.6f, 18.2f,
CLOSE,
// Center hexagon
MOVE_TO, 12, 8.2f,
LINE_TO, 16.5f, 10.8f,
LINE_TO, 16.5f, 16.0f,
LINE_TO, 12, 18.6f,
LINE_TO, 7.5f, 16.0f,
LINE_TO, 7.5f, 10.8f,
CLOSE,
NEW_PATH
